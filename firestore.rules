rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for SaoProfile
    function isValidSaoProfile(data) {
      return data.keys().hasAll(['orgName'])
        && data.orgName is string && data.orgName.size() > 0 && data.orgName.size() <= 200
        && (!('district' in data) || (data.district is string && data.district.size() <= 100))
        && (!('province' in data) || (data.province is string && data.province.size() <= 100))
        && (!('websiteUrl' in data) || (data.websiteUrl is string && data.websiteUrl.size() <= 500))
        && (!('facebookPage' in data) || (data.facebookPage is string && data.facebookPage.size() <= 200))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 100))
        && (!('emergencyPhone' in data) || (data.emergencyPhone is string && data.emergencyPhone.size() <= 100))
        && (!('lineId' in data) || (data.lineId is string && data.lineId.size() <= 100))
        && (!('workHours' in data) || (data.workHours is string && data.workHours.size() <= 150))
        && (!('vision' in data) || (data.vision is string && data.vision.size() <= 1000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for Executive
    function isValidExecutive(data) {
      return data.keys().hasAll(['name', 'position'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.position is string && data.position.size() > 0 && data.position.size() <= 200
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 100))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000))
        && (!('order' in data) || (data.order is number))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for PrPost
    function isValidPrPost(data) {
      return data.keys().hasAll(['title', 'content'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('tone' in data) || (data.tone is string && data.tone.size() <= 50))
        && (!('hashtags' in data) || (data.hashtags is string && data.hashtags.size() <= 500))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('images' in data) || (data.images is list && data.images.size() <= 10))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000))
        && (!('imageAdvice' in data) || (data.imageAdvice is string && data.imageAdvice.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for KnowledgeItem
    function isValidKnowledgeItem(data) {
      return data.keys().hasAll(['topic', 'answer'])
        && data.topic is string && data.topic.size() > 0 && data.topic.size() <= 200
        && data.answer is string && data.answer.size() > 0 && data.answer.size() <= 3000
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('question' in data) || (data.question is string && data.question.size() <= 500))
        && (!('keywords' in data) || (data.keywords is string && data.keywords.size() <= 300))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for ChatSession
    function isValidChatSession(data) {
      return data.keys().hasAll(['title'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Validation for ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll(['role', 'content'])
        && (data.role == 'user' || data.role == 'assistant')
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && (!('isVoice' in data) || (data.isVoice is bool))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 50));
    }

    // Collection matches
    match /sao_profiles/{profileId} {
      allow get, list: if true;
      allow create, update: if isValidId(profileId) && isValidSaoProfile(incoming());
      allow delete: if isValidId(profileId);
    }

    match /executives/{execId} {
      allow get, list: if true;
      allow create, update: if isValidId(execId) && isValidExecutive(incoming());
      allow delete: if isValidId(execId);
    }

    match /pr_posts/{postId} {
      allow get, list: if true;
      allow create, update: if isValidId(postId) && isValidPrPost(incoming());
      allow delete: if isValidId(postId);
    }

    match /knowledge_items/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId) && isValidKnowledgeItem(incoming());
      allow delete: if isValidId(itemId);
    }

    match /chat_sessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sessionId) && isValidChatSession(incoming());
      allow delete: if isValidId(sessionId);

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update: if isValidId(sessionId) && isValidId(messageId) && isValidChatMessage(incoming());
        allow delete: if isValidId(sessionId) && isValidId(messageId);
      }
    }
  }
}
